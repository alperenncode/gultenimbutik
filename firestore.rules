rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin kontrolü: admins/{email} dokümanının VARLIĞI yeterlidir.
    // E-postalar her yerde küçük harfle tutulmalıdır (rules büyük/küçük harfe duyarlıdır).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Herkese açık katalog verileri: okuma serbest, yazma sadece admin ──
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lookbook/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Ziyaretçi sayacı ──
    // Herkes sayacı yalnızca 1 artırabilir (total alanı tam +1 olmalı);
    // okumak sadece admin'e açıktır (panelde gösterilir).
    match /stats/visits {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['total', 'days'])
        && request.resource.data.total == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['total', 'days'])
        && request.resource.data.total == resource.data.total + 1;
    }

    // ── Site ayarları (iletişim bilgileri, hakkımızda metni, duyuru) ──
    // Herkes okuyabilir (site bu bilgileri gösterir), yalnızca admin yazabilir.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Ürün yorumları ──
    // Yazma: yalnızca giriş yapmış üyeler, kendi adına, onaysız (approved=false)
    // ve alan doğrulamalarıyla. Okuma: onaylı yorumlar herkese açık; admin
    // hepsini görür. Onaylama/silme yalnızca admin.
    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.approved == true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
             'productId', 'productSlug', 'productName',
             'userId', 'name', 'rating', 'text', 'approved', 'createdAt'
           ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.approved == false
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 1000;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Admin listesi ──
    // Kullanıcı SADECE kendi e-postasının admin olup olmadığını sorgulayabilir
    // (admin e-postalarının listelenmesini/enumerate edilmesini engeller).
    // Yazma client'tan tamamen kapalıdır: yeni admin eklemek Firebase Console'dan yapılır.
    match /admins/{email} {
      allow get: if isSignedIn() && request.auth.token.email == email;
      allow list: if false;
      allow write: if false;
    }

    // ── Kullanıcı profilleri (favoriler) ──
    // Herkes yalnızca KENDİ dokümanını okuyup yazabilir.
    // Güncellemede yalnızca wishlist ve displayName alanları değiştirilebilir
    // (ileride eklenebilecek yetki alanlarının kullanıcı tarafından
    // değiştirilmesini baştan engeller).
    match /users/{uid} {
      // Favori listesi tip ve boyut sınırı: dev doküman şişirme/istismarını engeller
      function validWishlist() {
        return request.resource.data.wishlist is list
          && request.resource.data.wishlist.size() <= 300;
      }

      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'wishlist', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && validWishlist();
      // email yalnızca Auth'taki güncel adresle eşleşiyorsa değiştirilebilir
      // (e-posta değiştirme özelliği profil dokümanını eşitlerken kullanır)
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['wishlist', 'displayName', 'email'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
            || request.resource.data.email == request.auth.token.email)
        && validWishlist();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Tanımlanmayan her yol varsayılan olarak kapalıdır.
  }
}
