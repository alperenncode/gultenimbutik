# ────────────────────────────────────────────────────────────────────
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local ASLA git'e commit edilmez (.gitignore'da).
# ────────────────────────────────────────────────────────────────────

# 1) Firebase service account anahtarı (SSR/SEO veri çekimi + admin doğrulaması).
#    ÜCRETSİZDİR, Blaze planı gerekmez.
#    Nasıl alınır:
#      a. Firebase Console → Proje Ayarları → Hizmet hesapları
#      b. "Yeni özel anahtar oluştur" → JSON dosyası iner
#      c. JSON'u base64'e çevirin (PowerShell):
#         [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
#      d. Çıktıyı aşağıya yapıştırın (tek satır)
FIREBASE_SERVICE_ACCOUNT_KEY=

# 2) Vercel Blob token'ı (görsel depolama).
#    Vercel Dashboard → projeniz → Storage → Blob store oluşturup projeye bağlayın.
#    Bağlandığında Vercel'de otomatik tanımlanır; YEREL kullanım (seed script,
#    localhost'tan görsel yükleme) için store sayfasındaki ".env.local" sekmesinden
#    kopyalayıp buraya yapıştırın.
BLOB_READ_WRITE_TOKEN=
