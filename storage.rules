rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Firestore'daki admins/{email} dokümanına çapraz-servis kontrolü.
    // Yalnızca (default) Firestore veritabanıyla çalışır.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }

    // Yalnızca görsel, en fazla 10 MB
    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    match /categories/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    match /lookbook/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    match /testimonials/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Tanımlanmayan her yol kapalıdır.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
